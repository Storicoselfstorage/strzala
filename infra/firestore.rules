rules_version = '2';
// Globalna tabela wyników STRZA/ŁA (projekt GCP: strzala-wyniki).
// Odczyt publiczny; zapis tylko CREATE poprawnego wpisu (walidacja pól);
// zmiana i kasowanie zabronione — wandalizm ograniczony do śmieciowych
// wpisów, które i tak odfiltruje sort top 5.
service cloud.firestore {
  match /databases/{database}/documents {
    match /wyniki/{doc} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'stars', 'ts'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 8
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 999999
        && request.resource.data.stars is int
        && request.resource.data.stars >= 0
        && request.resource.data.stars <= 30
        && request.resource.data.ts is int;
      allow update, delete: if false;
    }
  }
}
